[Unit]
Description=Restrict direct local model runtime access to trusted infrastructure
After=network-online.target docker.service ollama.service semena-freetoken-qwen36.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/semena-opencode
ExecStart=/opt/semena-opencode/scripts/apply_firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
