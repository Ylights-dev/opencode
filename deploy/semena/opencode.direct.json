{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/semena-gemma4",
  "small_model": "ollama/semena-gemma4",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Semena Ollama (direct evaluation)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "semena-gemma4": {
          "name": "Semena Agent (Gemma 4 12B)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
