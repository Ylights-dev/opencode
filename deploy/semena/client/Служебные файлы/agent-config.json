{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["semena"],
  "model": "semena/semena-qwen36",
  "small_model": "semena/semena-qwen36",
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
    "preserve_recent_tokens": 4096,
    "reserved": 12288
  },
  "mcp": {
    "semena_1c": {
      "type": "remote",
      "url": "http://10.1.50.40:3000/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:ONEC_MCP_API_KEY}",
        "X-API-Key": "{env:ONEC_MCP_API_KEY}"
      },
      "timeout": 45000
    },
    "semena_image": {
      "type": "remote",
      "url": "http://10.1.50.40:3003/sse",
      "enabled": true,
      "oauth": false,
      "timeout": 300000
    }
  },
  "provider": {
    "semena": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Семена для Сибири - локальная модель",
      "options": {
        "baseURL": "https://10.1.50.101:8443/v1",
        "apiKey": "{env:SEMENA_AGENT_API_KEY}"
      },
      "models": {
        "semena-qwen36": {
          "name": "Семена Агент",
          "options": {
            "reasoningEffort": "none",
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "limit": {
            "context": 57344,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "ask",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "memory": "allow",
    "skill": "allow",
    "read": "allow",
    "write": "allow",
    "semena_1c_*": "allow",
    "semena_image_image_*": "allow"
  }
}
