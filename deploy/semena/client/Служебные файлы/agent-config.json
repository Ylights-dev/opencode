{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["semena"],
  "model": "semena/semena-code",
  "small_model": "semena/semena-code",
  "provider": {
    "semena": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Семена для Сибири - локальная модель",
      "options": {
        "baseURL": "https://10.1.50.101:8443/v1",
        "apiKey": "{env:SEMENA_AGENT_API_KEY}"
      },
      "models": {
        "semena-code": {
          "name": "Семена Code",
          "limit": {
            "context": 12288,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "read": "allow",
    "write": "allow"
  },
  "instructions": ["AGENTS.md"]
}
