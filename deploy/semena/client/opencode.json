{
  "$schema": "https://opencode.ai/config.json",
  "model": "semena/semena-code",
  "small_model": "semena/semena-code",
  "provider": {
    "semena": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Семена для Сибири — локальная модель",
      "options": {
        "baseURL": "https://10.1.50.101:8443/v1",
        "apiKey": "{env:SEMENA_OPENCODE_API_KEY}"
      },
      "models": {
        "semena-code": {
          "name": "Семена Code",
          "limit": {
            "context": 12288,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "deny",
    "bash": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    }
  },
  "instructions": ["AGENTS.md"]
}
